{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Aderix/vantagate-mcp-server",
  "description": "VantaGate MCP Server & OpenAPI integration - Human-in-the-Loop for AI Agents",
  "repository": {
    "url": "https://github.com/Aderix/vantagate-mcp-server",
    "source": "github"
  },
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@vantagate/mcp-server",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "VANTA_API_KEY",
          "description": "Your VantaGate API Key (Format: vg_123...)",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        }
      ]
    }
  ]
}